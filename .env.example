# ============================================================
# BITS Vizag — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ─── Twilio Credentials ───────────────────────────────────
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Twilio WhatsApp Numbers ──────────────────────────────
# The WhatsApp-enabled "from" number on your Twilio account
TWILIO_FROM_NUMBER=+919392193834

# Recipient phone numbers (without country code)
TWILIO_JOSHUA_NUMBER=8297293834
TWILIO_SECRETARY_NUMBER=7093179090

# ─── API Authentication ───────────────────────────────────
# A long random string used to authenticate the /api/storeForm endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=replace-with-a-long-random-secret-string

# This same key is exposed to the browser (prefixed PUBLIC_) so the
# frontend can include it in request headers. It only guards this
# single internal endpoint — the Twilio credentials stay server-only.
PUBLIC_API_KEY=replace-with-a-long-random-secret-string
